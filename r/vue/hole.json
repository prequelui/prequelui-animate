{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "hole",
  "type": "registry:ui",
  "title": "Hole",
  "description": "A tunnel of rings with particles rising toward the camera.",
  "dependencies": [
    "motion",
