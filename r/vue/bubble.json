{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "bubble",
  "type": "registry:ui",
  "title": "Bubble",
  "description": "Slow gradient blobs that float and turn behind the content.",
  "dependencies": [
    "motion",
    "@lucide/vue"
