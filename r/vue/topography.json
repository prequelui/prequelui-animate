      "content": "<script setup>\nimport { onBeforeUnmount, onMounted, ref, watch } from \"vue\";\n\nconst CELL = 14;\n\nconst props = defineProps({\n  speed: { type: Number, default: 1 },\n  paused: { type: Boolean, default: false },\n  levels: { type: Number, default: 14 },\n  scale: { type: Number, default: 1 },\n  peak: { type: Number, default: 1 },\n  interactive: { type: Boolean, default: true },\n  lineColor: { type: String, default: undefined },\n});\n\nconst root = ref(null);\nconst canvasRef = ref(null);\nconst inView = ref(false);\nconst pageVisible = ref(true);\nconst reduceMotion = ref(false);\n\nconst ripples = [];\nconst pointer = {\n  x: 0,\n  y: 0,\n  hx: 0,\n  hy: 0,\n  raised: 0,\n  raisedTarget: 0,\n  placed: false,\n};\nlet time = 0;\nlet last = 0;\nlet waited = 0;\nlet frame = 0;\nlet observer;\nlet observerSize;\nlet media;\nlet onVisibility;\nlet onMedia;\n\nconst playing = () =>\n  inView.value && pageVisible.value && !reduceMotion.value && !props.paused;\n\nfunction contour(path, x, y, size, a, b, c, d, level) {\n  const top = () => [x + ((level - a) / (b - a)) * size, y];\n  const right = () => [x + size, y + ((level - b) / (c - b)) * size];\n  const bottom = () => [x + ((level - d) / (c - d)) * size, y + size];\n  const left = () => [x, y + ((level - a) / (d - a)) * size];\n  const line = (p, q) => {\n    path.moveTo(p[0], p[1]);\n    path.lineTo(q[0], q[1]);\n  };\n\n  const code =\n    (a > level ? 8 : 0) |\n    (b > level ? 4 : 0) |\n    (c > level ? 2 : 0) |\n    (d > level ? 1 : 0);\n  switch (code) {\n    case 0:\n    case 15:\n      return;\n    case 1:\n    case 14:\n      line(left(), bottom());\n      return;\n    case 2:\n    case 13:\n      line(bottom(), right());\n      return;\n    case 3:\n    case 12:\n      line(left(), right());\n      return;\n    case 4:\n    case 11:\n      line(top(), right());\n      return;\n    case 6:\n    case 9:\n      line(top(), bottom());\n      return;\n    case 7:\n    case 8:\n      line(left(), top());\n      return;\n    default: {\n      const center = (a + b + c + d) / 4;\n      if ((code === 5) === center > level) {\n        line(left(), top());\n        line(bottom(), right());\n      } else {\n        line(left(), bottom());\n        line(top(), right());\n      }\n    }\n  }\n}\n\nfunction draw(at) {\n  const canvas = canvasRef.value;\n  const container = root.value;\n  if (!canvas || !container) return;\n  const ctx = canvas.getContext(\"2d\");\n  if (!ctx) return;\n  const rect = canvas.getBoundingClientRect();\n  const width = rect.width;\n  const height = rect.height;\n  if (width < 2 || height < 2) return;\n  const dpr = canvas.width / Math.max(1, width);\n  const cols = Math.ceil(width / CELL) + 1;\n  const rows = Math.ceil(height / CELL) + 1;\n  const field = new Float32Array(cols * rows);\n  const feature = 170 * Math.max(0.2, props.scale);\n  const tz = at * 0.00008 * Math.max(0.1, props.speed);\n\n  for (let row = 0; row < rows; row++) {\n    for (let column = 0; column < cols; column++) {\n      const x = column * CELL;\n      const y = row * CELL;\n      const nx = x / feature;\n      const ny = y / feature;\n      let value =\n        Math.sin(nx * 1.7 + tz) * 0.55 +\n        Math.sin(ny * 2.1 - tz * 0.8) * 0.45 +\n        Math.sin((nx + ny) * 1.15 + tz * 0.55) * 0.3 +\n        Math.sin(nx * 3.1 - ny * 2.3 + tz * 1.3) * 0.18;\n      value /= 1.48;\n      if (pointer.raised > 0.001) {\n        const distance = Math.hypot(x - pointer.hx, y - pointer.hy);\n        value +=\n          pointer.raised * props.peak * 0.9 * Math.exp(-distance / 100);\n      }\n      for (const ripple of ripples) {\n        const progress = Math.min(1, Math.max(0, (at - ripple.start) / 2600));\n        const reach = Math.hypot(width, height) * 0.8;\n        const distance =\n          Math.hypot(x - ripple.x, y - ripple.y) - progress * reach;\n        value +=\n          0.75 *\n          (1 - progress) *\n          Math.cos((distance / 58) * 1.8) *\n          Math.exp(-(distance * distance) / (2 * 58 * 58));\n      }\n      field[row * cols + column] = value;\n    }\n  }\n\n  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n  ctx.clearRect(0, 0, width, height);\n  const color =\n    props.lineColor ??\n    getComputedStyle(container).color ??\n    (document.documentElement.classList.contains(\"dark\")\n      ? \"#e5e5e5\"\n      : \"#1c1c1c\");\n  const count = Math.max(4, Math.round(props.levels));\n  const step = 1.8 / count;\n  const minor = new Path2D();\n  const major = new Path2D();\n\n  for (let levelIndex = -count; levelIndex <= count; levelIndex++) {\n    const level = levelIndex * step;\n    const path = levelIndex % 5 === 0 ? major : minor;\n    for (let row = 0; row < rows - 1; row++) {\n      for (let column = 0; column < cols - 1; column++) {\n        const a = field[row * cols + column];\n        const b = field[row * cols + column + 1];\n        const c = field[(row + 1) * cols + column + 1];\n        const d = field[(row + 1) * cols + column];\n        const lowest = Math.min(a, b, c, d);\n        const highest = Math.max(a, b, c, d);\n        if (level < lowest || level > highest) continue;\n        contour(path, column * CELL, row * CELL, CELL, a, b, c, d, level);\n      }\n    }\n  }\n\n  ctx.strokeStyle = color;\n  ctx.lineCap = \"round\";\n  ctx.lineJoin = \"round\";\n  ctx.globalAlpha = 0.3;\n  ctx.lineWidth = 1;\n  ctx.stroke(minor);\n  ctx.globalAlpha = 0.68;\n  ctx.lineWidth = 1.4;\n  ctx.stroke(major);\n  ctx.globalAlpha = 1;\n}\n\nfunction resize() {\n  const container = root.value;\n  const canvas = canvasRef.value;\n  if (!container || !canvas) return;\n  const rect = container.getBoundingClientRect();\n  const dpr = Math.max(1, Math.min(window.devicePixelRatio || 1, 2));\n  const width = Math.max(1, Math.round(rect.width * dpr));\n  const height = Math.max(1, Math.round(rect.height * dpr));\n  if (canvas.width !== width || canvas.height !== height) {\n    canvas.width = width;\n    canvas.height = height;\n  }\n  canvas.style.width = `${rect.width}px`;\n  canvas.style.height = `${rect.height}px`;\n  draw(reduceMotion.value ? 0 : time);\n}\n\nfunction tick(now) {\n  const delta = Math.min(64, now - last);\n  last = now;\n  waited += delta;\n  if (waited >= 33) {\n    time += waited;\n    waited = 0;\n    pointer.hx += (pointer.x - pointer.hx) * 0.12;\n    pointer.hy += (pointer.y - pointer.hy) * 0.12;\n    pointer.raised +=\n      ((props.interactive ? pointer.raisedTarget : 0) - pointer.raised) * 0.08;\n    draw(time);\n  }\n  frame = requestAnimationFrame(tick);\n}\n\nfunction start() {\n  cancelAnimationFrame(frame);\n  frame = 0;\n  if (!playing()) {\n    draw(reduceMotion.value ? 0 : time);\n    return;\n  }\n  last = performance.now();\n  waited = 0;\n  frame = requestAnimationFrame(tick);\n}\n\nfunction point(event) {\n  const rect = event.currentTarget.getBoundingClientRect();\n  return { x: event.clientX - rect.left, y: event.clientY - rect.top };\n}\n\nfunction onPointerMove(event) {\n  if (!props.interactive || reduceMotion.value) return;\n  const { x, y } = point(event);\n  if (!pointer.placed) {\n    pointer.hx = x;\n    pointer.hy = y;\n    pointer.placed = true;\n  }\n  pointer.x = x;\n  pointer.y = y;\n  pointer.raisedTarget = 1;\n}\n\nfunction onPointerLeave() {\n  pointer.raisedTarget = 0;\n}\n\nfunction onPointerDown(event) {\n  if (!props.interactive || reduceMotion.value) return;\n  const { x, y } = point(event);\n  ripples.push({ x, y, start: time });\n  if (ripples.length > 4) ripples.splice(0, ripples.length - 4);\n}\n\nwatch(\n  () => [inView.value, pageVisible.value, reduceMotion.value, props.paused],\n  start,\n);\nwatch(\n  () => [props.speed, props.levels, props.scale, props.peak, props.lineColor],\n  () => {\n    if (playing()) start();\n    else draw(reduceMotion.value ? 0 : time);\n  },\n);\n\nonMounted(() => {\n  media = window.matchMedia(\"(prefers-reduced-motion: reduce)\");\n  reduceMotion.value = media.matches;\n  onMedia = () => {\n    reduceMotion.value = media.matches;\n  };\n  media.addEventListener?.(\"change\", onMedia);\n\n  pageVisible.value = document.visibilityState !== \"hidden\";\n  onVisibility = () => {\n    pageVisible.value = document.visibilityState !== \"hidden\";\n  };\n  document.addEventListener(\"visibilitychange\", onVisibility);\n\n  observer = new IntersectionObserver(\n    (entries) => {\n      inView.value = entries.some((entry) => entry.isIntersecting);\n    },\n    { threshold: 0 },\n  );\n  if (root.value) observer.observe(root.value);\n\n  observerSize = new ResizeObserver(resize);\n  if (root.value) observerSize.observe(root.value);\n  window.addEventListener(\"resize\", resize);\n  resize();\n  start();\n});\n\nonBeforeUnmount(() => {\n  cancelAnimationFrame(frame);\n  observer?.disconnect();\n  observerSize?.disconnect();\n  window.removeEventListener(\"resize\", resize);\n  if (onVisibility) document.removeEventListener(\"visibilitychange\", onVisibility);\n  media?.removeEventListener?.(\"change\", onMedia);\n});\n</script>\n\n<template>\n  <div\n    ref=\"root\"\n    data-slot=\"topography-background\"\n    class=\"relative size-full overflow-hidden bg-[#f5f2ec] text-[#1b1b1f] dark:bg-[#0b0b0f] dark:text-[#e8e6e1]\"\n    @pointermove=\"onPointerMove\"\n    @pointerleave=\"onPointerLeave\"\n    @pointerdown=\"onPointerDown\"\n  >\n    <canvas\n      ref=\"canvasRef\"\n      aria-hidden=\"true\"\n      class=\"pointer-events-none absolute inset-0\"\n    />\n    <slot />\n  </div>\n</template>\n"
    }
