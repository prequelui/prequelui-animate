\"y\":0},\"animate\":{\"y\":[0,-6,0],\"transition\":{\"duration\":0.5,\"ease\":[0.22,1,0.36,1]}}},\"p0\":{},\"p1\":{\"initial\":{\"scale\":1},\"animate\":{\"scale\":[1,0.9,1.16,0.97,1],\"transition\":{\"duration\":0.65,\"ease\":\"easeInOut\"}}}},\"loop\":{\"group\":{\"initial\":{\"y\":0},\"animate\":{\"y\":[0,-2,0],\"transition\":{\"duration\":1.4,\"ease\":\"easeInOut\"}}},\"p0\":{},\"p1\":{\"initial\":{\"scale\":1},\"animate\":{\"scale\":[1,1.05,1],\"transition\":{\"duration\":1.4,\"ease\":\"easeInOut\"}}}}},\"component\":\"PrequelMapPinIcon\"};\nconst host = ref(null);\nlet controller = null;\n\nconst markup = computed(() =>\n  renderIcon(spec, {\n    size: props.size,\n    variant: props.variant,\n    weight: props.weight,\n    className: props.className,\n    label: props.label,\n  }),\n);\n\nonMounted(() => {\n  controller = bindPrequelIcon(host.value, spec, () => ({\n    speed: props.speed,\n    tempo: props.tempo,\n    delay: props.delay,\n    loop: props.loop,\n    animate: props.animate,\n    animateOnHover: props.animateOnHover,\n    animateOnTap: props.animateOnTap,\n    animateOnView: props.animateOnView,\n    animateOnViewOnce: props.animateOnViewOnce,\n    animation: props.animation,\n  }));\n});\n\nonBeforeUnmount(() => controller?.destroy());\n</script>\n\n<template>\n  <span\n    ref=\"host\"\n    data-slot=\"prequel-icon-host\"\n    style=\"display: contents\"\n    v-html=\"markup\"\n  ></span>\n</template>\n"
