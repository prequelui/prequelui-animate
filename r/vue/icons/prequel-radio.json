e\":[0,-5,4,-2,0],\"transition\":{\"duration\":0.5,\"ease\":\"easeInOut\"}}},\"p0\":{},\"p1\":{},\"p2\":{\"initial\":{\"opacity\":1,\"scale\":1},\"animate\":{\"opacity\":[1,0.55,1],\"scale\":[1,1.06,1],\"transition\":{\"duration\":0.55,\"ease\":\"easeInOut\"}}},\"p3\":{},\"p4\":{}},\"tap\":{\"group\":{\"initial\":{\"rotate\":0},\"animate\":{\"rotate\":[0,-11,10,-6,3,0],\"transition\":{\"duration\":0.8,\"ease\":\"easeInOut\"}}},\"p0\":{},\"p1\":{},\"p2\":{\"initial\":{\"opacity\":1,\"scale\":1},\"animate\":{\"opacity\":[1,0.4,1],\"scale\":[1,1.14,1],\"transition\":{\"duration\":0.55,\"ease\":[0.22,1,0.36,1]}}},\"p3\":{},\"p4\":{}},\"loop\":{\"group\":{\"initial\":{\"rotate\":0},\"animate\":{\"rotate\":[0,-3,3,0],\"transition\":{\"duration\":1.4,\"ease\":\"easeInOut\"}}},\"p0\":{},\"p1\":{},\"p2\":{\"initial\":{\"opacity\":1,\"scale\":1},\"animate\":{\"opacity\":[1,0.55,1],\"scale\":[1,1.05,1],\"transition\":{\"duration\":1.5,\"ease\":\"easeInOut\"}}},\"p3\":{},\"p4\":{}}},\"component\":\"PrequelRadioIcon\"};\nconst host = ref(null);\nlet controller = null;\n\nconst markup = computed(() =>\n  renderIcon(spec, {\n    size: props.size,\n    variant: props.variant,\n    weight: props.weight,\n    className: props.className,\n    label: props.label,\n  }),\n);\n\nonMounted(() => {\n  controller = bindPrequelIcon(host.value, spec, () => ({\n    speed: props.speed,\n    tempo: props.tempo,\n    delay: props.delay,\n    loop: props.loop,\n    animate: props.animate,\n    animateOnHover: props.animateOnHover,\n    animateOnTap: props.animateOnTap,\n    animateOnView: props.animateOnView,\n    animateOnViewOnce: props.animateOnViewOnce,\n    animation: props.animation,\n  }));\n});\n\nonBeforeUnmount(() => controller?.destroy());\n</script>\n\n<template>\n  <span\n    ref=\"host\"\n    data-slot=\"prequel-icon-host\"\n    style=\"display: contents\"\n    v-html=\"markup\"\n  ></span>\n</template>\n"
