      "content": "<script setup>\nimport { computed, onBeforeUnmount, onMounted, ref } from \"vue\";\nimport { bindPrequelIcon, renderIcon } from \"./prequel-icon-core.js\";\n\nconst props = defineProps({\n  size: { type: Number, default: 28 },\n  variant: { type: String, default: \"outline\" },\n  weight: { type: String, default: \"regular\" },\n  speed: { type: Number, default: 1 },\n  tempo: { type: Number, default: 1 },\n  delay: { type: Number, default: 0 },\n  loop: { type: Boolean, default: false },\n  animate: { type: [Boolean, String], default: false },\n  animateOnHover: { type: Boolean, default: true },\n  animateOnTap: { type: Boolean, default: true },\n  animateOnView: { type: [Boolean, String], default: false },\n  animateOnViewOnce: { type: Boolean, default: true },\n  animation: { type: String, default: \"hover\" },\n  className: { type: String, default: \"\" },\n  label: { type: String, default: \"\" },\n});\n\nconst spec = {\"slug\":\"music\",\"name\":\"Music\",\"category\":\"Media\",\"parts\":[{\"tag\":\"path\",\"attrs\":{\"d\":\"M9 18V5l11-2v13\"}},{\"tag\":\"circle\",\"attrs\":{\"cx\":6,\"cy\":18,\"r\":3}},{\"tag\":\"circle\",\"attrs\":{\"cx\":17,\"cy\":16,\"r\":3}}],\"roles\":[\"primary\",\"primary\",\"accent\"],\"closed\":[false,true,true],\"draw\":[false,false,false],\"inside\":[false,false,false],\"hasClosed\":true,\"highlight\":{\"cx\":4.8,\"cy\":16.68,\"rx\":1.1,\"ry\":0.7},\"palette\":{\"color\":{\"primary\":\"oklch(0.62 0.18 330)\",\"primaryDark\":\"oklch(0.79 0.14 330)\",\"accent\":\"oklch(0.72 0.16 355)\",\"accentDark\":\"oklch(0.84 0.13 355)\"},\"emoji\":{\"primary\":\"oklch(0.62 0.22 350)\",\"secondary\":\"oklch(0.48 0.2 350)\",\"accent\":\"oklch(0.6 0.2 300)\"}},\"fill\":[],\"animations\":{\"hover\":{\"group\":{\"initial\":{\"y\":0},\"animate\":{\"y\":[0,-2,0],\"transition\":{\"duration\":0.45,\"ease\":\"easeOut\"}}},\"p0\":{},\"p1\":{\"initial\":{\"y\":0},\"animate\":{\"y\":[0,-2,0],\"transition\":{\"duration\":0.45,\"ease\":\"ease