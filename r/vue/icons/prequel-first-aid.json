      "content": "<script setup>\nimport { computed, onBeforeUnmount, onMounted, ref } from \"vue\";\nimport { bindPrequelIcon, renderIcon } from \"./prequel-icon-core.js\";\n\nconst props = defineProps({\n  size: { type: Number, default: 28 },\n  variant: { type: String, default: \"outline\" },\n  weight: { type: String, default: \"regular\" },\n  speed: { type: Number, default: 1 },\n  tempo: { type: Number, default: 1 },\n  delay: { type: Number, default: 0 },\n  loop: { type: Boolean, default: false },\n  animate: { type: [Boolean, String], default: false },\n  animateOnHover: { type: Boolean, default: true },\n  animateOnTap: { type: Boolean, default: true },\n  animateOnView: { type: [Boolean, String], default: false },\n  animateOnViewOnce: { type: Boolean, default: true },\n  animation: { type: String, default: \"hover\" },\n  className: { type: String, default: \"\" },\n  label: { type: String, default: \"\" },\n});\n\nconst spec = {\"slug\":\"first-aid\",\"name\":\"First Aid\",\"category\":\"Health\",\"parts\":[{\"tag\":\"rect\",\"attrs\":{\"x\":3,\"y\":3,\"width\":18,\"height\":18,\"rx\":4}},{\"tag\":\"path\",\"attrs\":{\"d\":\"M12 8v8\"}},{\"tag\":\"path\",\"attrs\":{\"d\":\"M8 12h8\"}}],\"roles\":[\"primary\",\"primary\",\"primary\"],\"closed\":[true,false,false],\"draw\":[false,true,false],\"inside\":[false,true,true],\"hasClosed\":true,\"highlight\":{\"cx\":8.4,\"cy\":8.04,\"rx\":2.4,\"ry\":1.25},\"palette\":{\"color\":{\"primary\":\"oklch(0.56 0.1 225)\",\"primaryDark\":\"oklch(0.78 0.08 225)\",\"accent\":\"oklch(0.66 0.13 200)\",\"accentDark\":\"oklch(0.8 0.1 200)\"},\"emoji\":{\"primary\":\"oklch(0.74 0.13 232)\",\"secondary\":\"oklch(0.58 0.13 232)\",\"accent\":\"oklch(0.82 0.16 85)\"}},\"fill\":[],\"animations\":{\"hover\":{\"group\":{\"initial\":{\"scale\":1},\"animate\":{\"scale\":[1,1.05,1],\"transition\":{\"duration\":0.55,\"ease\":\"easeInOut\"}}},\"p0\":{},\"p1\":{\"initial\":{\"pathLength\":1,\"opacity\":1},\"animate\":{\"pathLength\":[0,1