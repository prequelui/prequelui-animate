      "content": "<script setup>\nimport { computed, onBeforeUnmount, onMounted, ref } from \"vue\";\nimport { bindPrequelIcon, renderIcon } from \"./prequel-icon-core.js\";\n\nconst props = defineProps({\n  size: { type: Number, default: 28 },\n  variant: { type: String, default: \"outline\" },\n  weight: { type: String, default: \"regular\" },\n  speed: { type: Number, default: 1 },\n  tempo: { type: Number, default: 1 },\n  delay: { type: Number, default: 0 },\n  loop: { type: Boolean, default: false },\n  animate: { type: [Boolean, String], default: false },\n  animateOnHover: { type: Boolean, default: true },\n  animateOnTap: { type: Boolean, default: true },\n  animateOnView: { type: [Boolean, String], default: false },\n  animateOnViewOnce: { type: Boolean, default: true },\n  animation: { type: String, default: \"hover\" },\n  className: { type: String, default: \"\" },\n  label: { type: String, default: \"\" },\n});\n\nconst spec = {\"slug\":\"wallet\",\"name\":\"Wallet\",\"category\":\"Finance\",\"parts\":[{\"tag\":\"rect\",\"attrs\":{\"x\":3,\"y\":6,\"width\":18,\"height\":13,\"rx\":3}},{\"tag\":\"path\",\"attrs\":{\"d\":\"M3 9h18\"}},{\"tag\":\"circle\",\"attrs\":{\"cx\":16.5,\"cy\":13,\"r\":1.1}},{\"tag\":\"path\",\"attrs\":{\"d\":\"M13 6V4.5A1.5 1.5 0 0 1 14.5 3H19\"}}],\"roles\":[\"primary\",\"primary\",\"accent\",\"primary\"],\"closed\":[true,false,true,false],\"draw\":[false,false,false,false],\"inside\":[false,true,true,false],\"hasClosed\":true,\"highlight\":{\"cx\":8.4,\"cy\":9.64,\"rx\":2.4,\"ry\":1.25},\"palette\":{\"color\":{\"primary\":\"oklch(0.56 0.1 225)\",\"primaryDark\":\"oklch(0.78 0.08 225)\",\"accent\":\"oklch(0.66 0.13 200)\",\"accentDark\":\"oklch(0.8 0.1 200)\"},\"emoji\":{\"primary\":\"oklch(0.74 0.13 232)\",\"secondary\":\"oklch(0.58 0.13 232)\",\"accent\":\"oklch(0.82 0.16 85)\"}},\"fill\":[],\"animations\":{\"hover\":{\"group\":{\"initial\":{\"scale\":1},\"animate\":{\"scale\":[1,1.06,1],\"transition\":{\"duration\":0.45,\"ease\":\"easeOut\"}}},\"p0\":{},\"p1\":{},\"p2\":{\"initial\":{\"opacity\":1,\"scale\":1},\"animate\":{\"opacity\":[1,0.55,1],\"scale\":[1,1.06,1],\"transition\":{\"duration\":0.55,\"ease\":\"easeInOut\"}}},\"p3\":{}},\"tap\":{\"group\":{\"initial\":{\"scale\":1},\"animate\":{\"scale\":[1,0.9,1.14,0.98,1],\"transition\":{\"duration\":0.55,\"ease\":[0.22,1,0.36,1]}}},\"p0\":{},\"p1\":{},\"p2\":{\"initial\":{\"opacity\":1,\"scale\":1},\"animate\":{\"opacity\":[1,0.4,1],\"scale\":[1,1.14,1],\"transition\":{\"duration\":0.55,\"ease\":[0.22,1,0.36,1]}}},\"p3\":{}},\"loop\":{\"group\":{\"initial\":{\"scale\":1},\"animate\":{\"scale\":[1,1.04,1],\"transition\":{\"duration\":1.5,\"ease\":\"easeInOut\"}}},\"p0\":{},\"p1\":{},\"p2\":{\"initial\":{\"opacity\":1,\"scale\":1},\"animate\":{\"opacity\":[1,0.55,1],\"scale\":[1,1.05,1],\"transition\":{\"duration\":1.5,\"ease\":\"easeInOut\"}}},\"p3\":{}}},\"component\":\"PrequelWalletIcon\"};\nconst host = ref(null);\nlet controller = null;\n\nconst markup = computed(() =>\n  renderIcon(spec, {\n    size: props.size,\n    variant: props.variant,\n    weight: props.weight,\n    className: props.className,\n    label: props.label,\n  }),\n);\n\nonMounted(() => {\n  controller = bindPrequelIcon(host.value, spec, () => ({\n    speed: props.speed,\n    tempo: props.tempo,\n    delay: props.delay,\n    loop: props.loop,\n    animate: props.animate,\n    animateOnHover: props.animateOnHover,\n    animateOnTap: props.animateOnTap,\n    animateOnView: props.animateOnView,\n    animateOnViewOnce: props.animateOnViewOnce,\n    animation: props.animation,\n  }));\n});\n\nonBeforeUnmount(() => controller?.destroy());\n</script>\n\n<template>\n  <span\n    ref=\"host\"\n    data-slot=\"prequel-icon-host\"\n    style=\"display: contents\"\n    v-html=\"markup\"\n  ></span>\n</template>\n"
