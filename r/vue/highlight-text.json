{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "highlight-text",
  "type": "registry:ui",
  "title": "Highlight Text",
  "description": "A marker highlight that draws in behind the words.",
  "dependencies": [
    "motion",
    "@lucide/vue"
  ],
  "files": [
    {
      "path": "components/prequelui/HighlightText.vue",
      "target": "components/prequelui/HighlightText.vue",
      "type": "registry:ui",
      "content": "<script setup>\nimport { onBeforeUnmount, onMounted, ref } from \"vue\";\nimport { animate } from \"motion\";\n\nconst props = defineProps({\n  text: { type: String, required: true },\n  delay: { type: Number, default: 0 },\n  color: { type: String, default: \"color-mix(in oklab, #f5c542 38%, transparent)\" },\n  inView: { type: Boolean, default: false },\n  inViewOnce: { type: Boolean, default: true },\n});\n\nconst root = ref(null);\nconst controls = [];\nlet observer;\nlet played = false;\n\nconst reduce = () =>\n  typeof window !== \"undefined\" &&\n  window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n\nfunction play() {\n  if (played || !root.value) return;\n  played = true;\n  if (reduce()) {\n    root.value.style.backgroundSize = \"100% 100%\";\n    return;\n  }\n  controls.push(\n    animate(\n      root.value,\n      { backgroundSize: [\"0% 100%\", \"100% 100%\"] },\n      { duration: 2, ease: [0.42, 0, 0.58, 1], delay: props.delay / 1000 },\n    ),\n  );\n}\n\nonMounted(() => {\n  if (!props.inView) {\n    play();\n    return;\n  }\n  observer = new IntersectionObserver(\n    (entries) => {\n      if (entries.some((entry) => entry.isIntersecting)) {\n        play();\n        if (props.inViewOnce) observer?.disconnect();\n      } else if (!props.inViewOnce) {\n        played = false;\n        if (root.value) root.value.style.backgroundSize = \"0% 100%\";\n      }\n    },\n    { threshold: 0.35 },\n  );\n  if (root.value) observer.observe(root.value);\n});\n\nonBeforeUnmount(() => {\n  observer?.disconnect();\n  controls.forEach((control) => control.stop?.());\n});\n</script>\n\n<template>\n  <span\n    ref=\"root\"\n    data-slot=\"highlight-text\"\n    class=\"relative inline-block\"\n    :style=\"{\n      backgroundImage: `linear-gradient(${color}, ${color})`,\n      backgroundRepeat: 'no-repeat',\n      backgroundPosition: 'left center',\n      backgroundSize: '0% 100%',\n    }\"\n  >\n    {{ text }}\n  </span>\n</template>\n"
    }
  ]
}
