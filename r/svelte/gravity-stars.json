      "type": "registry:file",
      "content": "<script>\n  import { onMount } from \"svelte\";\n\n  let {\n    speed = 1,\n    paused = false,\n    starsCount = 80,\n    starsSize = 2,\n    starsOpacity = 0.75,\n    mouseInfluence = 110,\n    gravityStrength = 80,\n    gravity = \"attract\",\n    glowIntensity = 14,\n    interactive = true,\n    starColor = \"#f8fafc\",\n    class: className = \"\",\n    ...rest\n  } = $props();\n\n  let root;\n  let canvas;\n\n  let inView = $state(false);\n  let pageVisible = $state(true);\n  let reduce = $state(false);\n\n  const rate = $derived(Math.max(0.1, speed));\n  const playing = $derived(inView && pageVisible && !reduce && !paused);\n\n  const stars = [];\n  const mouse = { x: -9999, y: -9999 };\n  let frame = 0;\n\n  function create(width, height) {\n    const angle = Math.random() * Math.PI * 2;\n    const velocity = (0.16 + Math.random() * 0.4) * rate;\n    return {\n      x: Math.random() * width,\n      y: Math.random() * height,\n      vx: Math.cos(angle) * velocity,\n      vy: Math.sin(angle) * velocity,\n      size: 1 + Math.random() * starsSize,\n      opacity: starsOpacity,\n      glow: 1,\n    };\n  }\n\n  function draw() {\n    if (!canvas) return;\n    const ctx = canvas.getContext(\"2d\");\n    if (!ctx) return;\n    const rect = canvas.getBoundingClientRect();\n    const width = rect.width;\n    const height = rect.height;\n    if (width < 2 || height < 2) return;\n    const dpr = canvas.width / Math.max(1, width);\n    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n    ctx.clearRect(0, 0, width, height);\n    ctx.fillStyle = starColor;\n    ctx.shadowColor = starColor;\n    let blur = -1;\n    for (const star of stars) {\n      const next = glowIntensity * star.glow * 2;\n      if (Math.abs(next - blur) > 1) {\n        ctx.shadowBlur = next;\n        blur = next;\n      }\n      ctx.globalAlpha = star.opacity;\n      ctx.beginPath();\n      ctx.arc(star.x, star.y, star.size, 0, Math.PI * 2);\n      ctx.fill();\n    }\n    ctx.globalAlpha = 1;\n    ctx.shadowBlur = 0;\n  }\n\n  function resize() {\n    if (!root || !canvas) return;\n    const rect = root.getBoundingClientRect();\n    const dpr = Math.max(1, Math.min(window.devicePixelRatio || 1, 2));\n    const width = Math.max(1, Math.round(rect.width * dpr));\n    const height = Math.max(1, Math.round(rect.height * dpr));\n    if (canvas.width !== width || canvas.height !== height) {\n      canvas.width = width;\n      canvas.height = height;\n    }\n    canvas.style.width = `${rect.width}px`;\n    canvas.style.height = `${rect.height}px`;\n    if (stars.length === 0) {\n      const bounds = canvas.getBoundingClientRect();\n      for (let index = 0; index < starsCount; index++) {\n        stars.push(create(bounds.width, bounds.height));\n      }\n    }\n    draw();\n  }\n\n  function recreate() {\n    if (!canvas) return;\n    const bounds = canvas.getBoundingClientRect();\n    stars.length = 0;\n    for (let index = 0; index < starsCount; index++) {\n      stars.push(create(bounds.width, bounds.height));\n    }\n    draw();\n  }\n\n  function tick() {\n    if (!canvas) return;\n    const rect = canvas.getBoundingClientRect();\n    const width = rect.width;\n    const height = rect.height;\n    for (const star of stars) {\n      const dx = mouse.x - star.x;\n      const dy = mouse.y - star.y;\n      const distance = Math.hypot(dx, dy);\n      if (distance > 0 && distance < mouseInfluence) {\n        const force = (mouseInfluence - distance) / mouseInfluence;\n        const push = (force * gravityStrength * 0.0012) / rate;\n        const direction = gravity === \"attract\" ? 1 : -1;\n        star.vx += (dx / distance) * push * direction;\n        star.vy += (dy / distance) * push * direction;\n        star.opacity = Math.min(1, starsOpacity + force * 0.4);\n        star.glow = 1 + force * 2;\n      } else {\n        star.opacity = Math.max(starsOpacity * 0.3, star.opacity - 0.02);\n        star.glow = Math.max(1, star.glow - 0.06);\n      }\n      star.x += star.vx * rate;\n      star.y += star.vy * rate;\n      star.vx += (Math.random() - 0.5) * 0.0015;\n      star.vy += (Math.random() - 0.5) * 0.0015;\n      star.vx *= 0.999;\n      star.vy *= 0.999;\n      if (star.x < 0) star.x = width;\n      if (star.x > width) star.x = 0;\n      if (star.y < 0) star.y = height;\n      if (star.y > height) star.y = 0;\n    }\n    draw();\n    frame = requestAnimationFrame(tick);\n  }\n\n  function start() {\n    cancelAnimationFrame(frame);\n    frame = 0;\n    if (!playing) {\n      draw();\n      return;\n    }\n    frame = requestAnimationFrame(tick);\n  }\n\n  function onPointerMove(event) {\n    if (!interactive) return;\n    const rect = event.currentTarget.getBoundingClientRect();\n    mouse.x = event.clientX - rect.left;\n    mouse.y = event.clientY - rect.top;\n  }\n\n  function onPointerLeave() {\n    mouse.x = -9999;\n    mouse.y = -9999;\n  }\n\n  $effect(() => {\n    playing;\n    start();\n  });\n\n  $effect(() => {\n    const count = starsCount;\n    if (!canvas || canvas.width < 2) return;\n    if (stars.length !== count) recreate();\n    start();\n  });\n\n  onMount(() => {\n    const media = window.matchMedia(\"(prefers-reduced-motion: reduce)\");\n    reduce = media.matches;\n    const onMedia = () => {\n      reduce = media.matches;\n    };\n    media.addEventListener?.(\"change\", onMedia);\n\n    pageVisible = document.visibilityState !== \"hidden\";\n    const onVisibility = () => {\n      pageVisible = document.visibilityState !== \"hidden\";\n    };\n    document.addEventListener(\"visibilitychange\", onVisibility);\n\n    const observer = new IntersectionObserver(\n      (entries) => {\n        inView = entries.some((entry) => entry.isIntersecting);\n      },\n      { threshold: 0 },\n    );\n    if (root) observer.observe(root);\n\n    const sizeObserver = new ResizeObserver(resize);\n    if (root) sizeObserver.observe(root);\n    window.addEventListener(\"resize\", resize);\n    resize();\n\n    return () => {\n      cancelAnimationFrame(frame);\n      observer.disconnect();\n      sizeObserver.disconnect();\n      window.removeEventListener(\"resize\", resize);\n      document.removeEventListener(\"visibilitychange\", onVisibility);\n      media.removeEventListener?.(\"change\", onMedia);\n    };\n  });\n</script>\n\n<div\n  bind:this={root}\n  data-slot=\"gravity-stars-background\"\n  class={`relative size-full overflow-hidden bg-[radial-gradient(ellipse_at_50%_40%,#191826_0%,#06060b_72%)] ${className}`}\n  onpointermove={onPointerMove}\n  onpointerleave={onPointerLeave}\n  {...rest}\n>\n  <canvas\n    bind:this={canvas}\n    aria-hidden=\"true\"\n    class=\"pointer-events-none absolute inset-0\"\n  ></canvas>\n  <slot />\n</div>\n"
    }
  ]
