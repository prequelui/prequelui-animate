{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "gravity-stars",
  "type": "registry:component",
  "title": "Gravity Stars",
  "description": "Stars pulled and pushed by an interactive gravity well.",
  "dependencies": [
    "motion",
