{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "page-transition",
  "type": "registry:component",
  "title": "Page Transition",
  "description": "Page changes revealed with the View Transitions API.",
  "dependencies": [
    "motion",
    "lucide-svelte"
  ],
  "files": [
    {
      "path": "src/lib/components/prequelui/PageTransition.svelte",
      "target": "~/src/lib/components/prequelui/PageTransition.svelte",
      "type": "registry:file",
      "content": "<script>\n  import { onMount, tick } from \"svelte\";\n  import { animate } from \"motion\";\n\n  let {\n    pageKey = 0,\n    duration = 0.55,\n    from = \"top\",\n    fade = true,\n    class: className = \"\",\n    ...rest\n  } = $props();\n\n  let root;\n  let controls;\n  let lastKey = pageKey;\n\n  const reduce = () =>\n    typeof window !== \"undefined\" &&\n    window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n\n  function hiddenClip() {\n    if (from === \"bottom\") return \"inset(100% 0 0 0)\";\n    if (from === \"left\") return \"inset(0 100% 0 0)\";\n    if (from === \"right\") return \"inset(0 0 0 100%)\";\n    return \"inset(0 0 100% 0)\";\n  }\n\n  async function play() {\n    await tick();\n    if (!root) return;\n    controls?.stop?.();\n    if (reduce()) {\n      controls = animate(\n        root,\n        { opacity: [0, 1] },\n        { duration: 0.2, ease: [0.77, 0, 0.175, 1] },\n      );\n      return;\n    }\n    controls = animate(\n      root,\n      {\n        clipPath: [hiddenClip(), \"inset(0 0 0% 0)\"],\n        opacity: fade ? [0.6, 1] : 1,\n      },\n      { duration, ease: [0.77, 0, 0.175, 1] },\n    );\n  }\n\n  $effect(() => {\n    if (pageKey === lastKey) return;\n    lastKey = pageKey;\n    play();\n  });\n\n  onMount(() => {\n    play();\n    return () => controls?.stop?.();\n  });\n</script>\n\n<div bind:this={root} data-slot=\"page-transition\" class={`min-w-0 ${className}`} {...rest}>\n  <slot />\n</div>\n"
    }
  ]
}
