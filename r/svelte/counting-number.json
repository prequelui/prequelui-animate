{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "counting-number",
  "type": "registry:component",
  "title": "Counting Number",
  "description": "A number that counts to its target on a heavily damped spring.",
  "dependencies": [
    "motion",
    "lucide-svelte"
  ],
  "files": [
    {
      "path": "src/lib/components/prequelui/CountingNumber.svelte",
      "target": "~/src/lib/components/prequelui/CountingNumber.svelte",
      "type": "registry:file",
      "content": "<script>\n  import { onDestroy, onMount } from \"svelte\";\n  import { animate } from \"motion\";\n\n  let {\n    number,\n    fromNumber = 0,\n    padStart = false,\n    decimalPlaces = 0,\n    decimalSeparator = \".\",\n    thousandSeparator = undefined,\n    inView = false,\n    inViewOnce = true,\n    delay = 0,\n    initiallyStable = false,\n    transition = undefined,\n    onCompleted = undefined,\n    class: className = \"\",\n    ...rest\n  } = $props();\n\n  const countSpring = {\n    type: \"spring\",\n    stiffness: 90,\n    damping: 50,\n    restDelta: 0.001,\n    restSpeed: 0.01,\n  };\n\n  let root;\n  let visual;\n  let seen = $state(false);\n  const counter = { value: initiallyStable ? number : fromNumber };\n  let observer;\n  let timer;\n  let controls;\n\n  const reduce = () =>\n    typeof window !== \"undefined\" &&\n    window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n\n  function formatNumber(value, options) {\n    const { decimals, decimalSeparator, thousandSeparator, padLength } = options;\n    const fixed = Math.abs(value).toFixed(decimals);\n    const sign = value < 0 && Number(fixed) !== 0 ? \"-\" : \"\";\n    const [integer = \"0\", fraction] = fixed.split(\".\");\n    const padded = integer.padStart(padLength, \"0\");\n    const grouped =\n      thousandSeparator === undefined\n        ? padded\n        : padded.replace(/\\B(?=(\\d{3})+$)/g, thousandSeparator);\n    return fraction\n      ? `${sign}${grouped}${decimalSeparator}${fraction}`\n      : `${sign}${grouped}`;\n  }\n\n  let format = $derived({\n    decimals: decimalPlaces,\n    decimalSeparator,\n    thousandSeparator,\n    padLength: padStart ? Math.floor(Math.abs(number)).toString().length : 0,\n  });\n\n  let finalText = $derived(formatNumber(number, format));\n\n  function write(value) {\n    if (visual) visual.textContent = formatNumber(value, format);\n  }\n\n  function spring() {\n    return transition ?? countSpring;\n  }\n\n  function run() {\n    if (!seen) return;\n    clearTimeout(timer);\n    controls?.stop?.();\n    if (reduce()) {\n      counter.value = number;\n      write(counter.value);\n      onCompleted?.();\n      return;\n    }\n    timer = setTimeout(() => {\n      controls = animate(counter, { value: number }, {\n        ...spring(),\n        onUpdate: () => write(counter.value),\n        onComplete: () => onCompleted?.(),\n      });\n    }, delay);\n  }\n\n  let lastNumber = number;\n\n  $effect(() => {\n    const current = number;\n    if (current === lastNumber) return;\n    lastNumber = current;\n    if (seen) run();\n  });\n\n  $effect(() => {\n    write(counter.value);\n  });\n\n  onMount(() => {\n    write(counter.value);\n    if (!inView) {\n      seen = true;\n      run();\n      return;\n    }\n    observer = new IntersectionObserver(\n      (entries) => {\n        const visible = entries.some((entry) => entry.isIntersecting);\n        seen = visible;\n        if (!visible) return;\n        run();\n        if (inViewOnce) observer?.disconnect();\n      },\n      { threshold: 0.35 },\n    );\n    if (root) observer.observe(root);\n  });\n\n  onDestroy(() => {\n    clearTimeout(timer);\n    controls?.stop?.();\n    observer?.disconnect();\n  });\n</script>\n\n<span\n  bind:this={root}\n  data-slot=\"counting-number\"\n  class={`inline-block tabular-nums ${className}`}\n  {...rest}\n>\n  <span aria-hidden=\"true\" bind:this={visual}></span>\n  <span class=\"sr-only\">{finalText}</span>\n</span>\n"
    }
  ]
}
