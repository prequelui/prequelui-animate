{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "rotating-text",
  "type": "registry:component",
  "title": "Rotating Text",
  "description": "Words leave upward while the next one rises into place.",
  "dependencies": [
    "motion",
    "lucide-svelte"
  ],
  "files": [
    {
      "path": "src/lib/components/prequelui/RotatingText.svelte",
      "target": "~/src/lib/components/prequelui/RotatingText.svelte",
      "type": "registry:file",
      "content": "<script>\n  import { onMount, tick, untrack } from \"svelte\";\n  import { animate } from \"motion\";\n\n  let {\n    text = \"\",\n    texts: textsProp,\n    duration = 2000,\n    y = -50,\n    delay = 0,\n    align = \"start\",\n    loop = true,\n    transition,\n    class: className = \"\",\n    style = \"\",\n    ...rest\n  } = $props();\n\n  const DEFAULT_TWEEN = { duration: 0.3, ease: [0.23, 1, 0.32, 1] };\n\n  let root;\n  let word;\n  let index = $state(0);\n  let rotated = $state(false);\n  let onScreen = $state(true);\n  let pageVisible = $state(true);\n  let observer;\n  let timer;\n  let controls;\n  let lastSignature = \"\";\n\n  function reduce() {\n    return (\n      typeof window !== \"undefined\" &&\n      window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches\n    );\n  }\n\n  const tween = $derived(transition ?? DEFAULT_TWEEN);\n  const list = $derived.by(() => {\n    const value = textsProp ?? text ?? \"\";\n    const next = Array.isArray(value) ? value : [value];\n    return next.length ? next : [\"\"];\n  });\n  const unique = $derived([...new Set(list)]);\n  const current = $derived(list[index % list.length] ?? \"\");\n  const playing = $derived(\n    onScreen &&\n      pageVisible &&\n      (loop || index < list.length - 1),\n  );\n\n  function clearTimer() {\n    clearTimeout(timer);\n    timer = undefined;\n  }\n\n  function schedule() {\n    clearTimer();\n    if (!playing) return;\n    timer = setTimeout(() => {\n      rotated = true;\n      const next = loop\n        ? (index + 1) % list.length\n        : Math.min(index + 1, list.length - 1);\n      swap(next);\n      schedule();\n    }, rotated ? duration : delay);\n  }\n\n  function swap(next) {\n    const node = word;\n    const travel = reduce() ? 0 : y;\n\n    if (!node) {\n      index = next;\n      return;\n    }\n\n    controls?.stop?.();\n    controls = animate(node, { opacity: [1, 0], y: [0, travel] }, tween);\n\n    const finish = () => {\n      index = next;\n      tick().then(() => {\n        const entering = word;\n        if (!entering) return;\n        entering.style.opacity = \"0\";\n        entering.style.transform = `translateY(${-travel}px)`;\n        controls = animate(\n          entering,\n          { opacity: [0, 1], y: [-travel, 0] },\n          tween,\n        );\n      });\n    };\n\n    if (controls?.finished) controls.finished.then(finish, finish);\n    else finish();\n  }\n\n  function onVisibilityChange() {\n    pageVisible = !document.hidden;\n  }\n\n  $effect(() => {\n    const signature = list.join(\"\\u0001\");\n    untrack(() => {\n      if (lastSignature === \"\") {\n        lastSignature = signature;\n        return;\n      }\n      if (lastSignature === signature) return;\n      lastSignature = signature;\n      index = 0;\n      rotated = false;\n      clearTimer();\n      schedule();\n    });\n    return () => {};\n  });\n\n  $effect(() => {\n    const active = playing;\n    untrack(() => {\n      if (active) schedule();\n      else clearTimer();\n    });\n    return () => clearTimer();\n  });\n\n  onMount(() => {\n    observer = new IntersectionObserver(\n      (entries) => {\n        onScreen = entries.some((entry) => entry.isIntersecting);\n      },\n      { threshold: 0 },\n    );\n    if (root) observer.observe(root);\n    onVisibilityChange();\n    document.addEventListener(\"visibilitychange\", onVisibilityChange);\n    schedule();\n    return () => {\n      clearTimer();\n      observer?.disconnect();\n      document.removeEventListener(\"visibilitychange\", onVisibilityChange);\n      controls?.stop?.();\n    };\n  });\n</script>\n\n<span\n  bind:this={root}\n  data-slot=\"rotating-text\"\n  class={`relative inline-block overflow-hidden py-1 align-baseline ${className}`}\n  style={style}\n  {...rest}\n>\n  <span class=\"sr-only\">{list.join(\", \")}</span>\n  <span\n    aria-hidden=\"true\"\n    class=\"inline-grid\"\n    style={`justify-items:${align};align-items:baseline`}\n  >\n    {#each unique as item (item)}\n      <span class=\"invisible whitespace-nowrap\" style=\"grid-area:1 / 1\">{item}</span>\n    {/each}\n    <span style={`grid-area:1 / 1;justify-self:${align}`}>\n      <span bind:this={word} aria-hidden=\"true\" class=\"inline-block whitespace-nowrap\">{current}</span>\n    </span>\n  </span>\n</span>\n"
    }
  ]
}
