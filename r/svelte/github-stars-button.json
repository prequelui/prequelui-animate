{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "github-stars-button",
  "type": "registry:component",
  "title": "GitHub Stars Button",
  "description": "A compact star button with a counting number and fill.",
  "dependencies": [
    "motion",
    "lucide-svelte"
  ],
  "files": [
    {
      "path": "src/lib/components/prequelui/GitHubStarsButton.svelte",
      "target": "~/src/lib/components/prequelui/GitHubStarsButton.svelte",
      "type": "registry:file",
      "content": "<script>\n  import { onMount } from \"svelte\";\n  import { animate } from \"motion\";\n  import { Github, Star } from \"lucide-svelte\";\n\n  let {\n    username = \"prequelui\",\n    repo = \"prequelui-animate\",\n    value = 0,\n    delay = 0,\n    inView = true,\n    type = \"button\",\n    disabled = false,\n    class: className = \"\",\n    onclick = undefined,\n    ...rest\n  } = $props();\n\n  let root;\n  let starEl;\n  let particles;\n  let starred = $state(false);\n  let burst = $state(0);\n  let count = $state(\n    typeof window !== \"undefined\" &&\n      window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches\n      ? value\n      : 0,\n  );\n  let started = false;\n  let observer;\n  let controls;\n\n  const reduce = () =>\n    typeof window !== \"undefined\" &&\n    window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n\n  function startCount() {\n    if (started) return;\n    started = true;\n    if (reduce()) {\n      count = value;\n      return;\n    }\n    controls = animate(0, value, {\n      type: \"spring\",\n      stiffness: 90,\n      damping: 50,\n      delay: delay / 1000,\n      onUpdate: (latest) => (count = Math.round(latest)),\n    });\n  }\n\n  onMount(() => {\n    if (!inView) startCount();\n    else {\n      observer = new IntersectionObserver(\n        (entries) => {\n          if (entries.some((entry) => entry.isIntersecting)) {\n            startCount();\n            observer?.disconnect();\n          }\n        },\n        { threshold: 0.4 },\n      );\n      if (root) observer.observe(root);\n    }\n    return () => {\n      observer?.disconnect();\n      controls?.stop?.();\n    };\n  });\n\n  function toggle(event) {\n    onclick?.(event);\n    starred = !starred;\n    count += starred ? 1 : -1;\n    burst += 1;\n    if (reduce()) return;\n    if (starEl) {\n      animate(\n        starEl,\n        { scale: [1, 1.35, 1], rotate: [0, 12, 0] },\n        { duration: 0.45, ease: [0.23, 1, 0.32, 1] },\n      );\n    }\n    const nodes = particles ? Array.from(particles.children) : [];\n    nodes.forEach((node, index) => {\n      const angle = (index / nodes.length) * Math.PI * 2;\n      animate(\n        node,\n        {\n          opacity: [1, 0],\n          x: Math.cos(angle) * 26,\n          y: Math.sin(angle) * 26,\n          scale: 0.35,\n        },\n        { duration: 0.6, ease: [0.23, 1, 0.32, 1] },\n      );\n    });\n  }\n</script>\n\n<button\n  bind:this={root}\n  {type}\n  {disabled}\n  data-slot=\"github-stars-button\"\n  aria-label={`Star ${username}/${repo} on GitHub`}\n  class={`relative inline-flex h-9 items-center gap-2 overflow-visible rounded-lg border bg-background px-3 text-[13px] font-medium disabled:pointer-events-none disabled:opacity-50 ${className}`}\n  onclick={toggle}\n  {...rest}\n>\n  <Github class=\"size-4\" aria-hidden=\"true\" />\n  <span>Star</span>\n  <span class=\"h-4 w-px bg-border\" aria-hidden=\"true\" />\n  <span class=\"relative flex items-center gap-1 tabular-nums text-muted-foreground\">\n    <span bind:this={starEl} class=\"inline-flex\">\n      <Star\n        class=\"size-3.5 transition-colors duration-300 {starred\n          ? 'fill-[#f5b301] text-[#f5b301]'\n          : 'text-muted-foreground'}\"\n      />\n    </span>\n    {count.toLocaleString(\"en-US\")}\n  </span>\n  <span bind:this={particles} class=\"pointer-events-none absolute right-3 top-1/2\" aria-hidden=\"true\">\n    {#each Array.from({ length: 6 }) as _, index (burst + \"-\" + index)}\n      <span class=\"absolute size-1 rounded-full bg-[#f5b301] opacity-0\"></span>\n    {/each}\n  </span>\n</button>\n"
    }
  ]
}
