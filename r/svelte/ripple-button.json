{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "ripple-button",
  "type": "registry:component",
  "title": "Ripple Button",
  "description": "A button that emits a ripple from the exact point clicked.",
  "dependencies": [
    "motion",
    "lucide-svelte"
  ],
  "files": [
    {
      "path": "src/lib/components/prequelui/RippleButton.svelte",
      "target": "~/src/lib/components/prequelui/RippleButton.svelte",
      "type": "registry:file",
      "content": "<script>\n  import { onDestroy, tick } from \"svelte\";\n  import { animate } from \"motion\";\n\n  let {\n    hoverScale = 1,\n    tapScale = 0.97,\n    transition = undefined,\n    type = \"button\",\n    disabled = false,\n    class: className = \"\",\n    onclick = undefined,\n    children = undefined,\n    ...rest\n  } = $props();\n\n  const pressSpring = transition ?? {\n    type: \"spring\",\n    stiffness: 550,\n    damping: 30,\n    restSpeed: 10,\n  };\n\n  let button;\n  let rippleWrap;\n  let ripples = $state([]);\n  let hovered = false;\n  let nextId = 0;\n  const timers = new Set();\n\n  const reduce = () =>\n    typeof window !== \"undefined\" &&\n    window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n\n  function move(scale) {\n    if (!button || reduce()) return;\n    animate(button, { scale }, pressSpring);\n  }\n\n  function release() {\n    move(hovered && hoverScale !== 1 ? hoverScale : 1);\n  }\n\n  async function click(event) {\n    if (!button) {\n      onclick?.(event);\n      return;\n    }\n    const rect = button.getBoundingClientRect();\n    const scaleX = rect.width ? button.offsetWidth / rect.width : 1;\n    const scaleY = rect.height ? button.offsetHeight / rect.height : 1;\n    const id = nextId++;\n    ripples = [\n      ...ripples,\n      {\n        id,\n        x: (event.clientX - rect.left) * scaleX,\n        y: (event.clientY - rect.top) * scaleY,\n      },\n    ];\n    onclick?.(event);\n    await tick();\n    const node = rippleWrap?.querySelector(`[data-ripple=\"${id}\"]`);\n    if (node) {\n      if (reduce()) {\n        animate(node, { opacity: [0.5, 0] }, { duration: 0.6, ease: \"easeOut\" });\n      } else {\n        animate(\n          node,\n          { scale: [0, 10], opacity: [0.5, 0] },\n          { duration: 0.6, ease: \"easeOut\" },\n        );\n      }\n    }\n    const timer = setTimeout(() => {\n      ripples = ripples.filter((item) => item.id !== id);\n      timers.delete(timer);\n    }, 650);\n    timers.add(timer);\n  }\n\n  onDestroy(() => {\n    timers.forEach((timer) => clearTimeout(timer));\n    timers.clear();\n  });\n</script>\n\n<button\n  bind:this={button}\n  {type}\n  {disabled}\n  data-slot=\"ripple-button\"\n  class={`relative inline-flex h-10 items-center justify-center overflow-hidden rounded-lg bg-primary px-4 text-[13px] font-medium text-primary-foreground disabled:pointer-events-none disabled:opacity-50 ${className}`}\n  onclick={click}\n  onpointerdown={() => !disabled && move(tapScale)}\n  onpointerup={release}\n  onpointercancel={release}\n  onpointerenter={() => {\n    hovered = true;\n    if (hoverScale !== 1) move(hoverScale);\n  }}\n  onpointerleave={() => {\n    hovered = false;\n    move(1);\n  }}\n  {...rest}\n>\n  {#if children}{@render children()}{/if}\n  <span bind:this={rippleWrap} aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0\">\n    {#each ripples as ripple (ripple.id)}\n      <span\n        data-ripple={ripple.id}\n        class=\"absolute size-5 rounded-full bg-current opacity-50\"\n        style={`left:${ripple.x - 10}px;top:${ripple.y - 10}px`}\n      ></span>\n    {/each}\n  </span>\n</button>\n"
    }
  ]
}
