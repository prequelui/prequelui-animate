{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "morphing-text",
  "type": "registry:component",
  "title": "Morphing Text",
  "description": "Letters glide to their new positions when the string changes.",
  "dependencies": [
    "motion",
    "lucide-svelte"
