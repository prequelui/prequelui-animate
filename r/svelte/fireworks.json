{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "fireworks",
  "type": "registry:component",
  "title": "Fireworks",
  "description": "Autonomous firework bursts with configurable timing.",
  "dependencies": [
    "motion",
    "lucide-svelte"
