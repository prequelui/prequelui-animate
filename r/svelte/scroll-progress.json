{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "scroll-progress",
  "type": "registry:component",
  "title": "Scroll Progress",
  "description": "A scroll-linked progress bar driven without overshoot.",
  "dependencies": [
    "motion",
    "lucide-svelte"
  ],
  "files": [
    {
      "path": "src/lib/components/prequelui/ScrollProgress.svelte",
      "target": "~/src/lib/components/prequelui/ScrollProgress.svelte",
      "type": "registry:file",
      "content": "<script>\n  import { onDestroy, onMount } from \"svelte\";\n  import { animate } from \"motion\";\n\n  let {\n    target = null,\n    barClass = \"\",\n    class: className = \"\",\n    ...rest\n  } = $props();\n\n  let bar;\n  let controls;\n  let scroller;\n  let resizeHandler;\n\n  const reduce = () =>\n    typeof window !== \"undefined\" &&\n    window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n\n  const clamp = (value) => Math.min(1, Math.max(0, value));\n\n  function resolveTarget() {\n    if (!target) return null;\n    return target.current !== undefined ? target.current : target;\n  }\n\n  function read() {\n    if (!bar || typeof window === \"undefined\") return;\n    const element = resolveTarget();\n    let value = 0;\n\n    if (element && typeof element.scrollHeight === \"number\") {\n      const max = element.scrollHeight - element.clientHeight;\n      value = max > 0 ? clamp(element.scrollTop / max) : 0;\n    } else {\n      const max = document.documentElement.scrollHeight - window.innerHeight;\n      value = max > 0 ? clamp(window.scrollY / max) : 0;\n    }\n\n    controls?.stop?.();\n    if (reduce()) {\n      bar.style.transform = `scaleX(${value})`;\n      return;\n    }\n    controls = animate(\n      bar,\n      { scaleX: value },\n      { type: \"spring\", stiffness: 250, damping: 40, bounce: 0 },\n    );\n  }\n\n  onMount(() => {\n    scroller = resolveTarget() || window;\n    read();\n    scroller.addEventListener?.(\"scroll\", read, { passive: true });\n    resizeHandler = () => read();\n    window.addEventListener(\"resize\", resizeHandler);\n  });\n\n  onDestroy(() => {\n    controls?.stop?.();\n    scroller?.removeEventListener?.(\"scroll\", read);\n    if (resizeHandler) window.removeEventListener(\"resize\", resizeHandler);\n  });\n</script>\n\n<div\n  role=\"progressbar\"\n  aria-label=\"Scroll progress\"\n  data-slot=\"scroll-progress\"\n  class={`h-1 w-full overflow-hidden bg-accent ${className}`}\n  {...rest}\n>\n  <div\n    bind:this={bar}\n    class={`h-full origin-left bg-foreground ${barClass}`}\n    style=\"transform:scaleX(0)\"\n  ></div>\n</div>\n"
    }
  ]
}
