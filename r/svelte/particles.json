{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "particles",
  "type": "registry:component",
  "title": "Particles",
  "description": "A burst of particles around a trigger, for likes and stars.",
  "dependencies": [
    "motion",
    "lucide-svelte"
  ],
  "files": [
    {
      "path": "src/lib/components/prequelui/Particles.svelte",
      "target": "~/src/lib/components/prequelui/Particles.svelte",
      "type": "registry:file",
      "content": "<script>\n  import { onMount, tick } from \"svelte\";\n  import { animate } from \"motion\";\n\n  let {\n    animate: enabled = true,\n    inView = false,\n    inViewOnce = true,\n    inViewMargin = \"0px\",\n    trigger = 0,\n    side = \"top\",\n    align = \"center\",\n    count = 6,\n    radius = 30,\n    spread = 360,\n    duration = 0.8,\n    holdDelay = 0.05,\n    sideOffset = 0,\n    alignOffset = 0,\n    delay = 0,\n    size = 4,\n    color = \"currentColor\",\n    transition = undefined,\n    class: className = \"\",\n    ...rest\n  } = $props();\n\n  let root;\n  let layer;\n  let onScreen = $state(!inView);\n  let bursts = $state([]);\n  let observer;\n  let timer;\n  let generation = 0;\n  let controls = [];\n\n  const vertical = $derived(side === \"top\" || side === \"bottom\");\n  const alignPercent = $derived(\n    align === \"start\" ? \"0%\" : align === \"end\" ? \"100%\" : \"50%\",\n  );\n\n  const top = $derived(\n    vertical\n      ? side === \"top\"\n        ? `calc(0% - ${sideOffset}px)`\n        : `calc(100% + ${sideOffset}px)`\n      : `calc(${alignPercent} + ${alignOffset}px)`,\n  );\n\n  const left = $derived(\n    vertical\n      ? `calc(${alignPercent} + ${alignOffset}px)`\n      : side === \"left\"\n        ? `calc(0% - ${sideOffset}px)`\n        : `calc(100% + ${sideOffset}px)`,\n  );\n\n  const reduce = () =>\n    typeof window !== \"undefined\" &&\n    window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n\n  function stopControls() {\n    for (const control of controls) control?.stop?.();\n    controls = [];\n  }\n\n  async function burst() {\n    if (!enabled || !onScreen || reduce()) return;\n    generation += 1;\n    const current = generation;\n    bursts = Array.from({ length: count }, (_, index) => ({\n      key: `${current}-${index}`,\n      index,\n    }));\n\n    await tick();\n    const nodes = Array.from(layer?.children ?? []);\n    const fullCircle = spread % 360 === 0;\n    const step =\n      ((spread * Math.PI) / 180) /\n      Math.max(1, fullCircle ? count : count - 1);\n\n    nodes.forEach((node, index) => {\n      const angle = index * step;\n      const x = Math.round(Math.cos(angle) * radius * 100) / 100;\n      const y = Math.round(Math.sin(angle) * radius * 100) / 100;\n      controls.push(\n        animate(\n          node,\n          {\n            x: [0, x],\n            y: [0, y],\n            scale: [0, 1, 0],\n            opacity: [0, 1, 0],\n          },\n          {\n            duration,\n            delay: delay + index * holdDelay,\n            ease: \"easeOut\",\n            ...(transition ?? {}),\n          },\n        ),\n      );\n    });\n\n    const total = (duration + delay + holdDelay * (count - 1)) * 1000;\n    clearTimeout(timer);\n    timer = setTimeout(() => {\n      bursts = [];\n    }, total + 80);\n  }\n\n  export function fire() {\n    return burst();\n  }\n\n  $effect(() => {\n    const value = trigger;\n    if (value === 0) return;\n    burst();\n  });\n\n  onMount(() => {\n    if (!inView) return;\n    observer = new IntersectionObserver(\n      (records) => {\n        const visible = records.some((record) => record.isIntersecting);\n        onScreen = visible;\n        if (visible && inViewOnce) observer?.disconnect();\n      },\n      { threshold: 0.35, rootMargin: inViewMargin },\n    );\n    if (root) observer.observe(root);\n\n    return () => {\n      observer?.disconnect();\n      clearTimeout(timer);\n      stopControls();\n    };\n  });\n</script>\n\n<div\n  bind:this={root}\n  data-slot=\"particles\"\n  class={`relative ${className}`}\n  {...rest}\n>\n  <slot />\n  <div\n    bind:this={layer}\n    aria-hidden=\"true\"\n    class=\"pointer-events-none absolute inset-0 z-10\"\n  >\n    {#each bursts as dot (dot.key)}\n      <span\n        class=\"pointer-events-none absolute rounded-full\"\n        style={`top:${top};left:${left};width:${size}px;height:${size}px;margin-left:${-size / 2}px;margin-top:${-size / 2}px;background:${color}`}\n      ></span>\n    {/each}\n  </div>\n</div>\n"
    }
  ]
}
